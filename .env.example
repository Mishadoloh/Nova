# Shared secret used only between the server-side gateway and internal services.
NOVA_INTERNAL_TOKEN=replace-with-a-long-random-value
NOVA_GATEWAY_PORT=8080

# Site server configuration. Keep these values server-side.
NOVA_SERVICES_URL=http://127.0.0.1:8080
NOVA_SERVICES_TOKEN=replace-with-the-same-long-random-value

